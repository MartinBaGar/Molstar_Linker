{
  "name": "molstar_linker",
  "version": "3.1.0",
  "description": "[![Chrome Web Store](https://img.shields.io/badge/Chrome-Available-blue?logo=google-chrome)](#) [![Firefox Add-ons](https://img.shields.io/badge/Firefox-Available-orange?logo=firefox)](#)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wxt",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox"
  },
  "dependencies": {
    "molstar": "^5.5.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wxt": "^0.20.27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinBaGar/Molstar_Linker.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MartinBaGar/Molstar_Linker/issues"
  },
  "homepage": "https://github.com/MartinBaGar/Molstar_Linker#readme"
}
