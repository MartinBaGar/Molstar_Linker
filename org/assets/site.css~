:root {
  --bg: #fff; --fg: #222; --muted: #666; --border: #e3e3e3;
  --side: #fafafa; --accent: #0b5fc4; --code: #f3f3f3;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #16181d; --fg: #d8dbe0; --muted: #98a0ab; --border: #2c3038;
    --side: #1b1e24; --accent: #6cb2ff; --code: #22262d;
  }
}

body {
  margin: 0; background: var(--bg); color: var(--fg);
  font: 16px/1.65 system-ui, -apple-system, "Segoe UI", sans-serif;
}
a { color: var(--accent); }

/* ---------- Left panel: site menu ---------- */
#preamble {
  position: fixed; top: 0; bottom: 0; left: 0; width: 272px;
  box-sizing: border-box; overflow-y: auto; padding: 1rem;
  background: var(--side); border-right: 1px solid var(--border);
}
#preamble .brand {
  display: flex; align-items: center; gap: .6rem;
  font-weight: 700; font-size: 1.1rem; color: var(--fg);
  text-decoration: none; margin-bottom: 1rem;
}
#preamble .brand img { width: 32px; height: 32px; }
#menu ul { list-style: none; margin: 0; padding: 0; }
#menu ul ul { margin-left: .5rem; padding-left: .8rem; border-left: 1px solid var(--border); }
#menu li { margin: .15rem 0; }
#menu a { color: var(--fg); text-decoration: none; }
#menu a:hover { color: var(--accent); }
#menu a.active { color: var(--accent); font-weight: 600; }
#menu summary { cursor: pointer; }

/* ---------- Center: page content ---------- */
#content {
  margin: 0 260px 0 272px; padding: 2rem 3rem;
}
#content > * { max-width: 50rem; }
h1.title { margin-top: 0; }
img { max-width: 100%; height: auto; }
pre {
  background: var(--code); padding: .8rem 1rem; border-radius: 6px;
  overflow-x: auto;
}
code { background: var(--code); padding: .1em .3em; border-radius: 4px; }
pre code { padding: 0; background: none; }
table { border-collapse: collapse; }
th, td { border: 1px solid var(--border); padding: .35rem .7rem; }
blockquote { margin-left: 0; padding-left: 1rem; border-left: 3px solid var(--border); color: var(--muted); }

/* ---------- Right panel: outline of the current page ---------- */
#table-of-contents {
  position: fixed; top: 0; right: 0; bottom: 0; width: 244px;
  box-sizing: border-box; overflow-y: auto; padding: 1.5rem 1rem;
  border-left: 1px solid var(--border); font-size: .85rem;
}
#table-of-contents h2 {
  margin: 0 0 .6rem; font-size: .75rem; text-transform: uppercase;
  letter-spacing: .06em; color: var(--muted);
}
#table-of-contents ul { list-style: none; margin: 0; padding: 0; }
#table-of-contents ul ul { padding-left: .8rem; }
#table-of-contents a { color: var(--muted); text-decoration: none; }
#table-of-contents a:hover { color: var(--accent); }

/* ---------- Narrow screens ---------- */
@media (max-width: 1100px) {
  #table-of-contents { display: none; }
  #content { margin-right: 0; }
}
@media (max-width: 800px) {
  #preamble {
    position: static; width: auto; border-right: 0;
    border-bottom: 1px solid var(--border);
  }
  #content { margin-left: 0; padding: 1.2rem; }
}
